# ==========================================
# DineDesk - Environment Variables Template
# ==========================================

# 1. Database Connection URL (PostgreSQL)
# For Neon Serverless Postgres (Recommended for Vercel):
# DATABASE_URL="postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# For Supabase Postgres (Transaction Pooler):
# DATABASE_URL="postgresql://postgres.projectref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"
#
# For Local/Docker PostgreSQL:
DATABASE_URL="postgresql://postgres:password@localhost:5432/dinedesk?schema=public"

# 2. JWT Secret for Authentication & Sessions (Minimum 32 random characters)
JWT_SECRET="dinedesk_super_secret_jwt_key_at_least_32_characters_long"

# 3. Public Application URL
NEXT_PUBLIC_APP_URL="https://dinedesk.vercel.app"

# 4. Environment (set automatically by Vercel in production)
NODE_ENV="production"

