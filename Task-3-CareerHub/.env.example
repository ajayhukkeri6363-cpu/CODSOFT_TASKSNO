# ==============================================================================
# CareerHub — Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED (Production & Local)
# ------------------------------------------------------------------------------

# PostgreSQL Connection URL (Dedicated CareerHub Database)
# Examples:
#   Neon Serverless: postgresql://USER:PASSWORD@ep-xyz.us-east-2.aws.neon.tech/careerhub?sslmode=require
#   Supabase Pooler: postgresql://postgres.REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
#   Local Docker:    postgresql://postgres:password@localhost:5432/careerhub?schema=public
DATABASE_URL="postgresql://username:password@hostname:5432/careerhub?schema=public"

# Secret Key for JWT Session Token Signing & Verification (Min 32 characters)
JWT_SECRET="replace_with_a_secure_random_32_character_secret_key"


# ------------------------------------------------------------------------------
# 2. OPTIONAL (Cloud Integrations & Canonical URL)
# ------------------------------------------------------------------------------

# Public Application URL (Base URL for absolute links & metadata)
# Example: https://careerhub-portal.vercel.app
NEXT_PUBLIC_APP_URL="https://your-careerhub-deployment.vercel.app"

# Cloud Storage Configuration for Resume Uploads (AWS S3, Cloudflare R2, Supabase)
# If omitted or set to 'local', the system uses the built-in storage service with serverless fallbacks.
CLOUD_STORAGE_PROVIDER="local"
CLOUD_STORAGE_BUCKET="your-s3-bucket-name"
CLOUD_STORAGE_ACCESS_KEY="your-aws-access-key-id"
CLOUD_STORAGE_SECRET_KEY="your-aws-secret-access-key"
CLOUD_STORAGE_REGION="us-east-1"
CLOUD_STORAGE_ENDPOINT="https://s3.amazonaws.com"


# ------------------------------------------------------------------------------
# 3. DEMO / LOCAL ONLY
# ------------------------------------------------------------------------------

# Node Environment Mode (Automatically set to 'production' on Vercel)
NODE_ENV="production"
