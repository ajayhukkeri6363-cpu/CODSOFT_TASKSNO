# ==========================================
# CareerHub - Environment Variables Template
# ==========================================

# 1. Database Connection URL (PostgreSQL)
# For Neon Serverless Postgres (Recommended for Vercel):
# DATABASE_URL="postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/careerhub?sslmode=require"
#
# For Supabase Postgres (Transaction Pooler):
# DATABASE_URL="postgresql://postgres.projectref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"
#
# For Local/Docker PostgreSQL:
DATABASE_URL="postgresql://postgres:password@localhost:5432/careerhub?schema=public"

# 2. JWT Secret for Authentication & Sessions (Minimum 32 random characters)
JWT_SECRET="careerhub_jwt_super_secret_session_key_at_least_32_characters_long"

# 3. Cloud Storage Credentials (Optional - Local mock storage fallback active by default)
# CLOUD_STORAGE_PROVIDER="s3" # "s3" | "supabase" | "local"
# CLOUD_STORAGE_BUCKET="careerhub-resumes"
# CLOUD_STORAGE_ACCESS_KEY="your-access-key"
# CLOUD_STORAGE_SECRET_KEY="your-secret-key"
# CLOUD_STORAGE_REGION="us-east-1"
# CLOUD_STORAGE_ENDPOINT="https://s3.amazonaws.com"

# 4. Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 5. Environment
NODE_ENV="development"
